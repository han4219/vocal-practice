  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "csv-parse": "^6.1.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.4.0"
  }
}
